<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:padding="10dp"
    android:background="@drawable/bg_history_item">

    <TextView
        android:id="@+id/tvSaleNumber"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="#A0001"
        android:textStyle="bold"
        android:textSize="15sp"
        android:textColor="@color/textDark"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/tvAmount"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginEnd="8dp"/>

    <TextView
        android:id="@+id/tvClient"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Cliente: Nombre"
        android:textSize="12sp"
        android:textColor="#6B7280"
        app:layout_constraintStart_toStartOf="@id/tvSaleNumber"
        app:layout_constraintTop_toBottomOf="@id/tvSaleNumber"
        app:layout_constraintEnd_toStartOf="@id/btnGo"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="8dp"/>

    <TextView
        android:id="@+id/tvSeller"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Vendedor: Nombre"
        android:textSize="12sp"
        android:textColor="#6B7280"
        app:layout_constraintStart_toStartOf="@id/tvSaleNumber"
        app:layout_constraintTop_toBottomOf="@id/tvClient"
        app:layout_constraintEnd_toStartOf="@id/btnGo"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="8dp"/>

    <TextView
        android:id="@+id/tvAmount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="$0.00"
        android:textStyle="bold"
        android:textSize="14sp"
        android:textColor="@color/textDark"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnGo"
        android:layout_marginEnd="10dp"/>

    <TextView
        android:id="@+id/tvMonth"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Abril 2026"
        android:textSize="11sp"
        android:textColor="#6B7280"
        app:layout_constraintTop_toBottomOf="@id/tvAmount"
        app:layout_constraintEnd_toEndOf="@id/tvAmount"
        android:layout_marginTop="2dp"/>

    <ImageButton
        android:id="@+id/btnGo"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@android:color/transparent"
        android:src="@drawable/item_button"
        android:contentDescription="Ver"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>